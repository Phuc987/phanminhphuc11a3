        // Keyboard Group Highlight Logic
        function highlightKeyGroup(group) {
            const infoBox = document.getElementById('kb-info-box');
            const descriptions = {
                'esc': '<strong class="text-rose-400">Phím ESC (Escape):</strong> Hủy bỏ tác vụ hiện tại hoặc thoát khỏi chế độ toàn màn hình.',
                'func': '<strong class="text-indigo-400">Hàng Phím Chức Năng (F1 - F12):</strong> Thực hiện các phím tắt nhanh được lập trình trước bởi hệ điều hành hoặc phần mềm (ví dụ: F5 để Refresh, F11 Toàn màn hình).',
                'sys': '<strong class="text-slate-300">Phím Điều Khiển Hệ Thống:</strong> PrtSc (Chụp màn hình), Scroll Lock, Pause/Break.',
                'alpha': '<strong class="text-cyan-400">Cụm Phím Chữ & Số (Alphanumeric):</strong> Chứa 26 chữ cái Tiếng Anh, dãy số 0-9 và các dấu câu dùng nhập dữ liệu văn bản chính.',
                'ctrl': '<strong class="text-amber-400">Phím Điều Khiển (Ctrl, Alt, Win):</strong> Kết hợp với phím khác để tạo thành tổ hợp phím tắt tác vụ (VD: Ctrl+C, Ctrl+V).',
                'space': '<strong class="text-cyan-300">Phím Cách (Spacebar):</strong> Phím dài nhất trên bàn phím dùng chèn khoảng trắng giữa các từ.',
                'nav': '<strong class="text-purple-400">Cụm Điều Hướng (Navigation Keys):</strong> Gồm phím mũi tên, Insert, Delete, Home, End, PageUp, PageDown để di chuyển con trỏ văn bản.',
                'numpad': '<strong class="text-emerald-400">Cụm Phím Số (Numpad):</strong> Bố trí giống máy tính bỏ túi giúp kế toán/thu ngân nhập liệu con số siêu tốc.'
            };
            infoBox.innerHTML = descriptions[group] || 'Nhấp vào các phím để xem thông tin chi tiết.';
        }

        // Mouse DPI Simulator Logic
        function updateDpiSim(val) {
            document.getElementById('dpi-value').innerText = val + ' DPI';
        }

        function handleDpiMove(e) {
            const box = document.getElementById('dpi-box');
            const pointer = document.getElementById('dpi-pointer');
            const dpi = parseInt(document.getElementById('dpi-slider').value);
            
            const rect = box.getBoundingClientRect();
            const mouseX = e.clientX - rect.left;
            const mouseY = e.clientY - rect.top;

            // Sensitivity multiplier calculated from DPI
            const factor = (dpi / 1600);
            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            const offsetX = (mouseX - centerX) * factor;
            const offsetY = (mouseY - centerY) * factor;

            pointer.style.transform = `translate(${offsetX}px, ${offsetY}px)`;
        }

        // Port Filter Logic
        function filterPorts(cat) {
            const cards = document.querySelectorAll('.port-card');
            const buttons = document.querySelectorAll('.port-filter-btn');

            buttons.forEach(btn => {
                btn.classList.remove('bg-brand-600', 'text-white');
                btn.classList.add('bg-slate-900', 'text-slate-400');
            });
            event.target.classList.remove('bg-slate-900', 'text-slate-400');
            event.target.classList.add('bg-brand-600', 'text-white');

            cards.forEach(card => {
                if (cat === 'all' || card.dataset.category === cat) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // View Mode Controller (Continuous Canvas vs Presentation)
        function setViewMode(mode) {
            const btnCanvas = document.getElementById('btn-canvas-mode');
            const btnPres = document.getElementById('btn-presentation-mode');

            if (mode === 'presentation') {
                btnPres.classList.add('bg-brand-600', 'text-white');
                btnPres.classList.remove('text-slate-400');
                btnCanvas.classList.remove('bg-brand-600', 'text-white');
                btnCanvas.classList.add('text-slate-400');
                alert('Đã chuyển sang chế độ trình chiếu Slide! Bạn có thể cuộn từng Module để xem bài giảng.');
            } else {
                btnCanvas.classList.add('bg-brand-600', 'text-white');
                btnCanvas.classList.remove('text-slate-400');
                btnPres.classList.remove('bg-brand-600', 'text-white');
                btnPres.classList.add('text-slate-400');
            }
        }
    </script>
