<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Báo Cáo Tương Tác: Thiết Bị Ngoại Vi & Cổng Kết Nối Máy Tính</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Font Family -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f6ff',
                            100: '#e0edff',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            900: '#1e3a8a',
                        },
                        accent: {
                            cyan: '#06b6d4',
                            purple: '#a855f7',
                            emerald: '#10b981',
                            amber: '#f59e0b',
                            rose: '#f43f5e'
                        },
                        dark: {
                            bg: '#0b0f19',
                            card: '#111827',
                            border: '#1f2937',
                            hover: '#374151'
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Glassmorphism Effects */
        .glass-card {
            background: rgba(17, 24, 39, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glass-card-light {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(0, 0, 0, 0.08);
        }
        .glow-cyan {
            box-shadow: 0 0 25px -5px rgba(6, 182, 212, 0.3);
        }
        .glow-purple {
            box-shadow: 0 0 25px -5px rgba(168, 85, 247, 0.3);
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0b0f19;
        }
        ::-webkit-scrollbar-thumb {
            background: #1f2937;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #374151;
        }
        /* Gradient Text */
        .text-gradient {
            background: linear-gradient(135deg, #38bdf8 0%, #818cf8 50%, #c084fc 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>
<body class="bg-dark-bg text-slate-200 font-sans antialiased selection:bg-brand-500 selection:text-white min-h-screen flex flex-col">

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 glass-card border-b border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 to-brand-600 flex items-center justify-center text-white font-bold shadow-lg shadow-cyan-500/20">
                    <i data-lucide="cpu" class="w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="font-bold text-base sm:text-lg text-white leading-tight">Tin Học Cơ Bản</h1>
                    <p class="text-xs text-slate-400">Thiết Bị Ngoại Vi & Cổng Kết Nối • <span class="text-cyan-400 font-medium">Báo Cáo Tương Tác</span></p>
                </div>
            </div>

            <!-- Author & View Controller -->
            <div class="flex items-center gap-3">
                <div class="hidden md:flex flex-col text-right pr-3 border-r border-slate-800">
                    <span class="text-xs text-slate-400">Tác giả bài làm</span>
                    <span class="text-sm font-semibold text-cyan-300">Phan Minh Phuc</span>
                </div>

                <div class="flex bg-slate-900/80 p-1 rounded-xl border border-slate-800">
                    <button id="btn-canvas-mode" onclick="setViewMode('canvas')" class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-brand-600 text-white shadow-md">
                        <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                        <span>Canvas Scroll</span>
                    </button>
                    <button id="btn-presentation-mode" onclick="setViewMode('presentation')" class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition-all">
                        <i data-lucide="presentation" class="w-4 h-4"></i>
                        <span>Slide Viewer</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT CONTAINER -->
    <main id="app-container" class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- ================= HERO BANNER ================= -->
        <section class="relative rounded-3xl overflow-hidden mb-12 p-8 sm:p-12 glass-card border border-slate-800/80 bg-gradient-to-br from-slate-900/90 via-slate-900/50 to-brand-900/30">
            <div class="absolute -top-24 -right-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
                <div class="lg:col-span-7 space-y-6">
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-semibold">
                        <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                        <span>Hệ Thống Báo Cáo Mở Rộng 2026</span>
                    </div>
                    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
                        Kiến Trúc <span class="text-gradient">Thiết Bị Ngoại Vi</span> & Cổng Kết Nối Máy Tính
                    </h1>
                    <p class="text-slate-300 text-base leading-relaxed">
                        Thiết bị ngoại vi giúp mở rộng tối đa năng lực tương tác của máy tính với con người và môi trường xung quanh. Cổng kết nối giữ vai trò huyết mạch truyền tải dữ liệu, tín hiệu hình ảnh, âm thanh và năng lượng.
                    </p>
                    <div class="flex flex-wrap gap-4 pt-2">
                        <a href="#section-keyboard" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-semibold text-sm transition-all shadow-lg shadow-brand-600/30">
                            <i data-lucide="compass" class="w-4 h-4"></i>
                            Khám Phá Chi Tiết
                        </a>
                        <a href="#section-maintenance" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold text-sm transition-all">
                            <i data-lucide="shield-check" class="w-4 h-4"></i>
                            Hướng Dẫn Bảo Quản
                        </a>
                    </div>
                </div>

                <div class="lg:col-span-5 relative flex justify-center">
                    <div class="relative w-full max-w-md aspect-square rounded-2xl overflow-hidden shadow-2xl border border-slate-700/60 group">
                        <img src="https://images.unsplash.com/photo-1587829741301-dc798b83add3?auto=format&fit=crop&w=800&q=80" alt="Workstation setup" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
                        <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl glass-card border border-slate-700/50">
                            <div class="flex items-center justify-between text-xs text-slate-300">
                                <span class="flex items-center gap-1.5 font-medium"><i data-lucide="monitor" class="w-4 h-4 text-cyan-400"></i> Trạm Làm Việc Hiện Đại</span>
                                <span class="bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded-full border border-emerald-500/30 font-mono">Input / Output</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= MODULE NAVIGATION TABS ================= -->
        <div class="sticky top-20 z-40 mb-10 overflow-x-auto pb-2 pt-1 no-scrollbar">
            <div class="flex gap-2 min-w-max bg-slate-900/90 p-1.5 rounded-2xl border border-slate-800 shadow-xl backdrop-blur-md">
                <a href="#section-overview" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2">
                    <i data-lucide="layers" class="w-4 h-4 text-cyan-400"></i> Tổng Quan
                </a>
                <a href="#section-keyboard" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2">
                    <i data-lucide="keyboard" class="w-4 h-4 text-purple-400"></i> Bàn Phím
                </a>
                <a href="#section-mouse" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2">
                    <i data-lucide="mouse" class="w-4 h-4 text-emerald-400"></i> Chuột Máy Tính
                </a>
                <a href="#section-printer" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2">
                    <i data-lucide="printer" class="w-4 h-4 text-amber-400"></i> Máy In & 3D
                </a>
                <a href="#section-fax" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2">
                    <i data-lucide="send" class="w-4 h-4 text-rose-400"></i> Máy Fax
                </a>
                <a href="#section-ports" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2">
                    <i data-lucide="cable" class="w-4 h-4 text-brand-400"></i> Cổng Kết Nối
                </a>
                <a href="#section-matrix" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2">
                    <i data-lucide="table" class="w-4 h-4 text-teal-400"></i> Ma Trận So Sánh
                </a>
                <a href="#section-maintenance" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800 transition-all flex items-center gap-2">
                    <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400"></i> Quy Trình Bảo Quản
                </a>
            </div>
        </div>

        <!-- ================= SECTION 1: TỔNG QUAN ================= -->
        <section id="section-overview" class="scroll-mt-28 mb-16">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-8 h-8 rounded-lg bg-cyan-500/20 text-cyan-400 flex items-center justify-center font-bold">01</div>
                <h2 class="text-2xl font-bold text-white">Tổng Quan Thiết Bị Ngoại Vi & Chuẩn Giao Tiếp</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Card Input -->
                <div class="glass-card p-6 rounded-2xl border border-slate-800 hover:border-cyan-500/40 transition-all group">
                    <div class="w-12 h-12 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <i data-lucide="arrow-down-left" class="w-6 h-6"></i>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2">Thiết Bị Nhập (Input)</h3>
                    <p class="text-slate-400 text-sm mb-4 leading-relaxed">
                        Thu thập dữ liệu, lệnh tác vụ từ thế giới thực và chuyển đổi thành tín hiệu số mà máy tính (CPU/RAM) có thể xử lý.
                    </p>
                    <div class="space-y-2">
                        <span class="inline-block px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 text-xs font-mono">Bàn phím</span>
                        <span class="inline-block px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 text-xs font-mono">Chuột</span>
                        <span class="inline-block px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 text-xs font-mono">Micro</span>
                        <span class="inline-block px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 text-xs font-mono">Webcam / Scanner</span>
                    </div>
                </div>

                <!-- Card Output -->
                <div class="glass-card p-6 rounded-2xl border border-slate-800 hover:border-purple-500/40 transition-all group">
                    <div class="w-12 h-12 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <i data-lucide="arrow-up-right" class="w-6 h-6"></i>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2">Thiết Bị Xuất (Output)</h3>
                    <p class="text-slate-400 text-sm mb-4 leading-relaxed">
                        Nhận dữ liệu đã qua xử lý từ máy tính và chuyển đổi thành dạng con người có thể cảm nhận (màn hình, âm thanh, bản in).
                    </p>
                    <div class="space-y-2">
                        <span class="inline-block px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 text-xs font-mono">Màn hình</span>
                        <span class="inline-block px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 text-xs font-mono">Máy in</span>
                        <span class="inline-block px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 text-xs font-mono">Loa / Tai nghe</span>
                        <span class="inline-block px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 text-xs font-mono">Máy chiếu</span>
                    </div>
                </div>

                <!-- Card Input/Output -->
                <div class="glass-card p-6 rounded-2xl border border-slate-800 hover:border-emerald-500/40 transition-all group">
                    <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                        <i data-lucide="repeat" class="w-6 h-6"></i>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2">Thiết Bị Nhập / Xuất (I/O)</h3>
                    <p class="text-slate-400 text-sm mb-4 leading-relaxed">
                        Thiết bị hai chiều có khả năng vừa nhận thông tin đầu vào vừa truyền phản hồi hoặc lưu trữ dữ liệu trao đổi.
                    </p>
                    <div class="space-y-2">
                        <span class="inline-block px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 text-xs font-mono">Màn hình cảm ứng</span>
                        <span class="inline-block px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 text-xs font-mono">Máy Fax</span>
                        <span class="inline-block px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 text-xs font-mono">Ổ cứng di động / USB</span>
                        <span class="inline-block px-2.5 py-1 rounded-md bg-slate-800 text-slate-300 text-xs font-mono">Network Card</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= SECTION 2: BÀN PHÍM ================= -->
        <section id="section-keyboard" class="scroll-mt-28 mb-16">
            <div class="flex items-center justify-between mb-6">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-purple-500/20 text-purple-400 flex items-center justify-center font-bold">02</div>
                    <h2 class="text-2xl font-bold text-white">Bàn Phím Máy Tính (Keyboard Masterclass)</h2>
                </div>
                <span class="text-xs font-mono text-purple-400 bg-purple-500/10 px-3 py-1 rounded-full border border-purple-500/20">Primary Input Device</span>
            </div>

            <!-- Keyboard Layout Interactive Diagram -->
            <div class="glass-card p-6 sm:p-8 rounded-3xl border border-slate-800 mb-8">
                <h3 class="text-lg font-bold text-white mb-2 flex items-center gap-2">
                    <i data-lucide="layout" class="w-5 h-5 text-purple-400"></i>
                    Cấu Tạo & Phân Khu Bàn Phím Chuẩn (104 Key ANSI)
                </h3>
                <p class="text-slate-400 text-sm mb-6">Bấm vào các vùng màu bên dưới để xem vai trò chức năng kỹ thuật tương ứng.</p>

                <!-- Interactive Visual Keyboard Diagram -->
                <div class="bg-slate-950 p-4 rounded-2xl border border-slate-800 overflow-x-auto mb-6">
                    <div class="min-w-[700px] space-y-2 font-mono text-xs select-none">
                        <!-- Function Keys Row -->
                        <div class="flex gap-1.5">
                            <button onclick="highlightKeyGroup('esc')" class="key-btn w-10 h-10 rounded bg-rose-900/40 border border-rose-500/50 text-rose-300 hover:bg-rose-600 hover:text-white transition-all flex items-center justify-center font-bold">ESC</button>
                            <div class="w-4"></div>
                            <button onclick="highlightKeyGroup('func')" class="key-btn flex-1 h-10 rounded bg-indigo-900/30 border border-indigo-500/40 text-indigo-300 hover:bg-indigo-600 hover:text-white transition-all flex items-center justify-center font-bold">F1 - F4</button>
                            <button onclick="highlightKeyGroup('func')" class="key-btn flex-1 h-10 rounded bg-indigo-900/30 border border-indigo-500/40 text-indigo-300 hover:bg-indigo-600 hover:text-white transition-all flex items-center justify-center font-bold">F5 - F8</button>
                            <button onclick="highlightKeyGroup('func')" class="key-btn flex-1 h-10 rounded bg-indigo-900/30 border border-indigo-500/40 text-indigo-300 hover:bg-indigo-600 hover:text-white transition-all flex items-center justify-center font-bold">F9 - F12</button>
                            <div class="w-4"></div>
                            <button onclick="highlightKeyGroup('sys')" class="key-btn w-28 h-10 rounded bg-slate-800 border border-slate-700 text-slate-400 hover:bg-slate-700 hover:text-white transition-all flex items-center justify-center">PrtSc / Sys</button>
                        </div>

                        <!-- Main Alphanumeric Block -->
                        <div class="flex gap-2">
                            <div class="flex-1 space-y-1.5">
                                <button onclick="highlightKeyGroup('alpha')" class="key-btn w-full h-12 rounded bg-cyan-950/40 border border-cyan-500/30 text-cyan-300 hover:bg-cyan-600 hover:text-white transition-all flex items-center justify-center font-semibold text-sm">
                                    Cụm Phím Chữ & Số (Alphanumeric Keys: A-Z, 0-9, Ký Tự Đặc Biệt)
                                </button>
                                <div class="flex gap-1.5">
                                    <button onclick="highlightKeyGroup('ctrl')" class="key-btn w-16 h-10 rounded bg-amber-900/30 border border-amber-500/40 text-amber-300 font-bold hover:bg-amber-600 hover:text-white transition-all flex items-center justify-center">Ctrl/Alt</button>
                                    <button onclick="highlightKeyGroup('space')" class="key-btn flex-1 h-10 rounded bg-cyan-900/20 border border-cyan-500/30 text-cyan-200 hover:bg-cyan-600 hover:text-white transition-all flex items-center justify-center font-bold">SPACEBAR (Phím Cách)</button>
                                    <button onclick="highlightKeyGroup('ctrl')" class="key-btn w-20 h-10 rounded bg-amber-900/30 border border-amber-500/40 text-amber-300 font-bold hover:bg-amber-600 hover:text-white transition-all flex items-center justify-center">Win / Menu</button>
                                </div>
                            </div>

                            <!-- Navigation Block -->
                            <div class="w-28 space-y-1.5">
                                <button onclick="highlightKeyGroup('nav')" class="key-btn w-full h-12 rounded bg-purple-900/30 border border-purple-500/40 text-purple-300 hover:bg-purple-600 hover:text-white transition-all flex items-center justify-center font-bold">Nav (Ins/Del/Home)</button>
                                <button onclick="highlightKeyGroup('nav')" class="key-btn w-full h-10 rounded bg-purple-900/30 border border-purple-500/40 text-purple-300 hover:bg-purple-600 hover:text-white transition-all flex items-center justify-center font-bold">Phím Mũi Tên (← ↑ ↓ →)</button>
                            </div>

                            <!-- Numpad Block -->
                            <div class="w-32">
                                <button onclick="highlightKeyGroup('numpad')" class="key-btn w-full h-24 rounded bg-emerald-900/30 border border-emerald-500/40 text-emerald-300 hover:bg-emerald-600 hover:text-white transition-all flex items-center justify-center font-bold text-center leading-tight">
                                    Numpad<br><span class="text-[10px] font-normal text-emerald-400/80">Cụm Phím Số</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Info Box for Keyboard Group -->
                <div id="kb-info-box" class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-sm text-slate-300">
                    <span class="font-bold text-purple-400">💡 Hướng dẫn:</span> Nhấp vào bất kỳ nhóm phím nào trên mô hình để xem giải thích chi tiết.
                </div>
            </div>

            <!-- Switch Mechanics Explorer -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <div class="glass-card p-5 rounded-2xl border border-slate-800">
                    <div class="flex items-center justify-between mb-3">
                        <h4 class="font-bold text-white text-base">Bàn Phím Màng (Membrane)</h4>
                        <span class="text-xs bg-slate-800 px-2 py-0.5 rounded text-slate-400">Phổ Thông</span>
                    </div>
                    <p class="text-slate-400 text-xs mb-3 leading-relaxed">
                        Sử dụng các lớp màng cao su dẫn điện. Khi nhấn, đệm cao su lún xuống chạm mạch điện dưới đáy.
                    </p>
                    <ul class="text-xs space-y-1 text-slate-300 list-disc list-inside">
                        <li><strong>Ưu điểm:</strong> Giá thành rẻ, chống nước nhẹ, gõ êm.</li>
                        <li><strong>Nhược điểm:</strong> Cảm giác gõ "hoãn" (mushy), tuổi thọ thấp (~5 triệu lần nhấn).</li>
                    </ul>
                </div>

